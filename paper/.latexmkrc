@default_files = ( "main.tex" );

$pdf_mode = 1;        # Generate a pdf using pdflatex
$dvi_mode = 0;        # Don't generate a dvi file
$postscript_mode = 0; # Don't generate a postsript file
$out_dir = "build";   # Put all the output in "\build"
$bibtex_use = 2       # Generate (and cleanup) .bbl files
